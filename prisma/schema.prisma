// JOC Education — Prisma schema
// Run: npx prisma@6 migrate dev --name init
// Requires .env.local with DATABASE_URL (pooler port 6543) and DIRECT_URL (direct port 5432)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Schools ──────────────────────────────────────────────────────────────────
// A School is the account. Teachers belong to one, the subscription belongs to
// the school rather than to any individual, and the JOC team manages the
// relationship through the internal admin console.

model School {
  id      String  @id @default(cuid())
  name    String
  slug    String  @unique
  /// Free-text region used for the Teachers' Board filter (e.g. "Brooklyn", "Lakewood")
  region  String?
  city    String?
  country String? @default("United States")
  website String?

  /// Email domains belonging to this school, e.g. ["darcheitorah.org"].
  /// Someone signing in with an address on one of these joins the school
  /// automatically. Consumer domains (gmail.com and the like) are ignored.
  emailDomains String[] @default([])

  type         SchoolType     @default(DAY_SCHOOL)
  enrollment   EnrollmentBand @default(MEDIUM)
  /// Actual enrollment where known — `enrollment` is the pricing band
  studentCount Int?

  status SchoolStatus @default(PROSPECT)

  // ── Where they are up to ───────────────────────────────────────────────
  // Each of these is a date rather than a tick, so the board can say how long
  // something has been true. A tick only ever says "yes", and the useful
  // question is almost always "since when".

  /// This school's id inside the JOC App. Set by hand in the console, and
  /// the only thing the two systems are matched on — never the name.
  /// "Yeshiva Darchei Torah" and "Darchei Torah" are the same school and
  /// would never have matched.
  appSchoolId String? @unique

  /// When the school sent the list of students taking part.
  studentListAt DateTime?
  /// When the JOC live screen went up in the building.
  liveScreenAt  DateTime?
  /// When their school store opened.
  storeOpenAt   DateTime?

  /// Chesed hours logged in the JOC App and waiting for somebody to approve
  /// them. This lives in the app, not here, so it carries the moment it was
  /// last read — a number with no date is a number nobody can trust.
  unapprovedHours   Int?
  unapprovedCheckedAt DateTime?

  /// JOC staff member who owns this relationship
  accountManagerId String?
  accountManager   User?   @relation("AccountManager", fields: [accountManagerId], references: [id], onDelete: SetNull)

  members      User[]              @relation("SchoolMembers")
  contacts     SchoolContact[]
  activities   SchoolActivity[]
  invitations  Invitation[]
  subscription Subscription?
  boardPosts   BoardPost[]
  planRequests PlanChangeRequest[]
  events       ProgramEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders        Order[]
  formResponses FormResponse[]
  appStats      AppSchoolStats?
  appChallenges AppChallengeStat[]
  appMessages   AppSchoolMessage[]

  programLights SchoolProgramLight[]
  agendaItems   AdminMeetingItem[]
  enrollments   ProgramEnrollment[]
  ambassadors   ProgramAmbassador[]
  ambassadorInvites AmbassadorInvite[]

  @@index([status])
  @@index([accountManagerId])
}

/// A person at the school. May or may not have a login — a principal who signs
/// the contract but never uses the site still needs to be reachable.
model SchoolContact {
  id        String  @id @default(cuid())
  schoolId  String
  name      String
  title     String?
  email     String?
  phone     String?
  isPrimary Boolean @default(false)
  notes     String? @db.Text

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  /// Programs this person runs at their school.
  enrollments ProgramEnrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

/// Relationship timeline: calls, emails, meetings and demos logged by hand,
/// plus an automatic audit trail of plan changes and access grants.
model SchoolActivity {
  id         String       @id @default(cuid())
  schoolId   String
  type       ActivityType @default(NOTE)
  summary    String
  detail     String?      @db.Text
  /// When the call/meeting actually happened — may differ from createdAt
  occurredAt DateTime     @default(now())

  /// JOC staff member who logged it (null for system-generated entries)
  authorId String?
  author   User?   @relation("ActivityAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([schoolId, occurredAt])
}

/// Granting access. A JOC admin invites an email to a school; the invite is
/// consumed on first sign-in.
model Invitation {
  id         String           @id @default(cuid())
  email      String
  schoolId   String
  role       Role             @default(TEACHER)
  token      String           @unique @default(cuid())
  status     InvitationStatus @default(PENDING)
  expiresAt  DateTime
  acceptedAt DateTime?

  invitedById String?
  invitedBy   User?   @relation("Inviter", fields: [invitedById], references: [id], onDelete: SetNull)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([email])
}

/// A school admin asking JOC to change their plan or seat count.
/// Deliberately a request, not a purchase — nothing is charged and nothing
/// changes until JOC acts on it.
model PlanChangeRequest {
  id       String @id @default(cuid())
  schoolId String

  /// What they are asking for, in their own words
  message    String  @db.Text
  /// Optional structured hint about what they want
  wantsPlan  String?
  wantsSeats Int?

  status   PlanRequestStatus @default(OPEN)
  /// JOC's reply, shown back to the school
  response String?           @db.Text

  requestedById String?
  requestedBy   User?   @relation("PlanRequester", fields: [requestedById], references: [id], onDelete: SetNull)

  respondedById String?
  respondedBy   User?     @relation("PlanResponder", fields: [respondedById], references: [id], onDelete: SetNull)
  respondedAt   DateTime?

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, createdAt])
  @@index([status])
}

enum PlanRequestStatus {
  OPEN
  ANSWERED
  ACTIONED
  DECLINED
}

/// Demo requests from the educator landing page scheduler — the top of the
/// sales pipeline, before a School record exists.
model DemoRequest {
  id           String            @id @default(cuid())
  name         String
  email        String
  schoolName   String?
  phone        String?
  /// Requested slot, as chosen on the landing page
  requestedFor DateTime?
  message      String?           @db.Text
  status       DemoRequestStatus @default(NEW)
  /// Set once the request is converted into a School record
  schoolId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// ─── NextAuth v5 / @auth/prisma-adapter ──────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(TEACHER)

  schoolId String?
  school   School? @relation("SchoolMembers", fields: [schoolId], references: [id], onDelete: SetNull)

  /// Which console role this person holds, where they hold one. Null means
  /// their access follows the built-in default for their `role` — which is
  /// what every teacher and school admin does.
  adminRoleId String?
  adminRole   AdminRole? @relation("AdminRoleMembers", fields: [adminRoleId], references: [id], onDelete: SetNull)

  /// Set false to suspend a login without deleting the account
  active     Boolean   @default(true)
  lastSeenAt DateTime?

  /// scrypt hash for email+password sign-in. Interim, until Google OAuth is
  /// live — see src/lib/password.ts. Null means this account can only sign in
  /// with Google.
  passwordHash       String?
  /// Forces a password change on next sign-in (set when an admin issues one)
  mustChangePassword Boolean @default(false)

  accounts      Account[]
  sessions      Session[]
  savedLessons  SavedLesson[]
  boardPosts    BoardPost[]
  boardLikes    BoardLike[]
  uploadedFiles StoredFile[]  @relation("UploadedFiles")
  orders        Order[]
  roomMessages  RoomMessage[]
  roomMembers   RoomMember[]
  formResponses FormResponse[] @relation("FormResponses")
  programsLed   ProgramPage[] @relation("ProgramLeads")

  /// A teacher who runs their school's JOC App: sees their own school's
  /// sign-ups and activity, and not the plan or the seats. Deliberately not
  /// the SCHOOL_ADMIN role — that one is about money and people.
  schoolAppAdmin Boolean @default(false)

  managedSchools   School[]            @relation("AccountManager")
  loggedActivities SchoolActivity[]    @relation("ActivityAuthor")
  sentInvitations  Invitation[]        @relation("Inviter")
  editedFields     SiteField[]         @relation("FieldEditor")
  publishedFields  SiteFieldHistory[]  @relation("FieldPublisher")
  planRequests     PlanChangeRequest[] @relation("PlanRequester")
  planResponses    PlanChangeRequest[] @relation("PlanResponder")
  accessGrants     Subscription[]      @relation("AccessGranter")

  lightsSet        SchoolProgramLight[] @relation("LightSetBy")

  /// Programs this student runs at their school, and the ones they supervise.
  ambassadorships  ProgramAmbassador[]  @relation("AmbassadorUser")
  supervising      ProgramAmbassador[]  @relation("AmbassadorSupervisor")
  ambassadorInvites AmbassadorInvite[]  @relation("AmbassadorInviter")
  agendaRaised     AdminMeetingItem[]   @relation("AgendaRaisedBy")
  agendaDecided    AdminMeetingItem[]   @relation("AgendaDecidedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([role])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ─── Subscriptions ────────────────────────────────────────────────────────────
// Belongs to the school, not to a user.

model Subscription {
  id       String @id @default(cuid())
  schoolId String @unique

  plan     Plan
  status   SubscriptionStatus @default(ACTIVE)
  /// Monthly or annual billing
  interval BillingInterval    @default(ANNUAL)

  stripeCustomerId String?   @unique
  stripeSubId      String?   @unique
  currentPeriodEnd DateTime?

  /// Number of staff logins included
  seats Int @default(1)

  /// Access granted manually by JOC rather than paid for
  grantedManually Boolean    @default(false)
  /// What kind of grant — scholarship, pilot or comp. Null when paid.
  grantKind       GrantKind?
  /// Why. Required whenever grantedManually is set, so the record of
  /// generosity is answerable later: who was given what, why, and by whom.
  grantNote       String?    @db.Text
  /// Who approved it
  grantedById     String?
  grantedBy       User?      @relation("AccessGranter", fields: [grantedById], references: [id], onDelete: SetNull)
  grantedAt       DateTime?
  /// When to look at it again — JOC reviews these each Elul
  grantReviewOn   DateTime?

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// ─── Lesson Plans ─────────────────────────────────────────────────────────────

model LessonPlan {
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  theme       String
  title       String
  description String    @db.Text
  grade       Grade
  timeMinutes Int
  prep        PrepLevel
  published   Boolean   @default(true)
  featured    Boolean   @default(false)
  /// Chesed Cycle this lesson belongs to, by slug (see src/lib/cycles.ts)
  cycleSlug   String?
  /// Which week of that cycle it is for, 1-based. Null means it belongs to
  /// the cycle generally rather than to one particular week.
  cycleWeek   Int?

  files      LessonFile[]
  objectives LessonObjective[]
  materials  LessonMaterial[]
  steps      LessonStep[]
  discussion LessonDiscussion[]
  savedBy    SavedLesson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cycleSlug])
  @@index([cycleSlug, cycleWeek])
}

model LessonFile {
  id       Int    @id @default(autoincrement())
  lessonId Int
  name     String
  url      String
  order    Int    @default(0)

  lesson LessonPlan @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

model LessonObjective {
  id       Int    @id @default(autoincrement())
  lessonId Int
  text     String
  order    Int    @default(0)

  lesson LessonPlan @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

model LessonMaterial {
  id       Int    @id @default(autoincrement())
  lessonId Int
  text     String
  order    Int    @default(0)

  lesson LessonPlan @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

model LessonStep {
  id          Int    @id @default(autoincrement())
  lessonId    Int
  duration    String
  title       String
  description String @db.Text
  order       Int    @default(0)

  lesson LessonPlan @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

model LessonDiscussion {
  id       Int    @id @default(autoincrement())
  lessonId Int
  text     String @db.Text
  order    Int    @default(0)

  lesson LessonPlan @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

model SavedLesson {
  userId   String
  lessonId Int

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson LessonPlan @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  savedAt DateTime @default(now())

  @@id([userId, lessonId])
}

// ─── Resources ────────────────────────────────────────────────────────────────

model Resource {
  id          Int     @id @default(autoincrement())
  tag         String
  title       String
  description String  @db.Text
  fileUrl     String?
  published   Boolean @default(true)
  cycleSlug   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cycleSlug])
}

// ─── Teachers' Board ──────────────────────────────────────────────────────────

model BoardPost {
  id       String  @id @default(cuid())
  userId   String
  title    String
  body     String  @db.Text
  grade    Grade
  likes    Int     @default(0)
  approved Boolean @default(false)

  schoolId   String?
  school     School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  /// Denormalised for display and for posts whose school record was removed
  region     String
  schoolName String

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  likedBy BoardLike[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([approved])
  @@index([schoolId])
}

model BoardLike {
  userId String
  postId String

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  post BoardPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, postId])
}

// ─── Shop ─────────────────────────────────────────────────────────────────────

model Product {
  id            String  @id @default(cuid())
  name          String
  description   String  @db.Text
  /// Cents.
  price         Int
  unit          String  @default("item")
  inStock       Boolean @default(true)
  stripePriceId String?

  /// Shop grouping — "Classroom", "Events", "Books".
  category  String  @default("Classroom")
  /// Picture on the shop card. A /api/files/ id, or any URL.
  imageUrl  String?
  /// Set for something delivered as a download rather than posted —
  /// a handbook PDF, for instance. Released once the order is fulfilled.
  fileUrl   String?
  /// Off until someone has set a real price.
  published Boolean @default(true)
  sort      Int     @default(0)

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Editable site content ───────────────────────────────────────────────────
// Every string, number, image path and link on the public site reads from a
// SiteField rather than a literal in a component, so the Education Team can
// change the site without a deploy.
//
// Draft/publish: edits write `valueDraft`. Nothing public changes until a
// publish copies draft → published and writes a SiteFieldHistory row, which
// is what makes rollback possible.

model SiteField {
  id      String        @id @default(cuid())
  /// Which public page this belongs to, e.g. "landing", "cycles"
  page    String
  /// Section within the page, e.g. "hero", "demo"
  section String
  /// Stable identifier within the section, e.g. "headline"
  key     String
  /// Human label shown in the editor
  label   String
  type    SiteFieldType @default(SHORT_TEXT)
  /// Optional guidance shown under the input
  help    String?

  /// Live value. JSON-encoded for REPEATABLE, plain string otherwise.
  valuePublished String? @db.Text
  /// Pending edit. Null means no unpublished change.
  valueDraft     String? @db.Text

  sort Int @default(0)

  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("FieldEditor", fields: [updatedById], references: [id], onDelete: SetNull)

  history SiteFieldHistory[]

  createdAt DateTime @default(now())

  @@unique([page, section, key])
  @@index([page, sort])
}

model SiteFieldHistory {
  id      String  @id @default(cuid())
  fieldId String
  /// The value that was live after this publish
  value   String? @db.Text

  publishedAt   DateTime @default(now())
  publishedById String?
  publishedBy   User?    @relation("FieldPublisher", fields: [publishedById], references: [id], onDelete: SetNull)

  field SiteField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@index([fieldId, publishedAt])
}

enum SiteFieldType {
  SHORT_TEXT
  LONG_TEXT
  URL
  EMAIL
  NUMBER
  IMAGE
  /// Ordered array of small objects, stored as JSON
  REPEATABLE
}

// ─── Site statistics ──────────────────────────────────────────────────────────
// Every number shown publicly comes from here, with a source and an as-of date,
// so nothing on the site is a figure nobody can account for.

model Stat {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  value     String
  /// Where the number came from: JOC App export, manual count, CRM
  source    String?
  asOf      DateTime
  published Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  /// Teacher at a partner school — access follows the school's subscription
  TEACHER
  /// Main contact for their school — access still follows the subscription
  SCHOOL_ADMIN
  /// Anyone at Just One Chesed. Free access to everything, changes nothing.
  /// This is what a @justonechesed.org address gets automatically.
  STAFF
  /// JOC programming team — runs the calendar of events and the school
  /// accounts behind them. Deliberately cannot touch educational material:
  /// lessons, resources, the shop or the Teachers' Board.
  PROGRAM_STAFF
  /// JOC educational team — uploads and edits lessons, resources and content
  ADMIN
  /// Full control: school accounts, plans, discounts, users and roles
  SUPER_ADMIN
}

enum SchoolType {
  DAY_SCHOOL
  YESHIVA
  SEMINARY
  CHEDER
  HIGH_SCHOOL
  OTHER
}

enum EnrollmentBand {
  /// Under 150 students
  SMALL
  /// 150–400 students
  MEDIUM
  /// 400+ students
  LARGE
}

enum SchoolStatus {
  PROSPECT
  DEMO_SCHEDULED
  TRIAL
  ACTIVE
  LAPSED
  CHURNED
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  /// Somebody from JOC physically went to the school.
  VISIT
  DEMO
  /// System-generated audit entries
  PLAN_CHANGE
  ACCESS_GRANTED
  ACCESS_REVOKED
  STATUS_CHANGE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum DemoRequestStatus {
  NEW
  CONTACTED
  SCHEDULED
  COMPLETED
  CONVERTED
  LOST
}

enum Grade {
  es
  ms
  hs
}

enum PrepLevel {
  Minimal
  Moderate
  Substantial
}

enum Plan {
  SINGLE_TEACHER
  JOC_EDUCATION
  APP_AND_EDUCATION
  FULL_PARTNERSHIP
}

enum BillingInterval {
  MONTHLY
  ANNUAL
}

enum GrantKind {
  /// The school cannot afford it
  SCHOLARSHIP
  /// Trying it with us
  PILOT
  /// Internal or a courtesy
  COMP
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

// ─── Uploaded files ───────────────────────────────────────────────────────────
// Worksheets, source sheets and printables live in the database rather than in
// object storage. That is a deliberate trade: it needs no second set of
// credentials, so the education team can upload from the day the database is
// connected. Files are capped well below the point where this becomes a
// problem, and moving to object storage later only changes lib/files.ts.

model StoredFile {
  id       String @id @default(cuid())
  name     String
  mimeType String
  /// Bytes. Enforced against FILE_SIZE_LIMIT before the row is written.
  size     Int
  data     Bytes

  uploadedById String?
  uploadedBy   User?   @relation("UploadedFiles", fields: [uploadedById], references: [id], onDelete: SetNull)

  reportPhotos EventReport[] @relation("ReportPhoto")

  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ─── Programs ─────────────────────────────────────────────────────────────────
// The programs JOC runs for schools. Held here rather than in lib/programs.ts
// so the education team can add one — Boots for Israel, Run for Chesed, Just
// One Simcha — without a deploy. The static list is the fallback until the
// first row is published.

model ProgramPage {
  id          Int    @id @default(autoincrement())
  slug        String @unique
  name        String
  /// Event, Ongoing, Platform, One-time, Trip
  tag         String
  tagline     String
  description String @db.Text
  heroColor   String @default("#2D46AF")
  /// The line under the title: "Half-day setup · All grade levels"
  meta        String

  /// Which subscriptions include it.
  available     String[]
  whatsIncluded String[]

  /// Set for a program that lives on another JOC site, e.g. Chesed Match.
  externalHref String?
  cta          String  @default("Register your school")

  published Boolean @default(false)

  /// Announced but not running yet. Shown on the site with a "Coming soon"
  /// badge and no Register button — telling a school to register for
  /// something that does not exist yet is how you lose them.
  comingSoon Boolean @default(false)

  /// The form shown on this program's own page — a registration, a sign-up.
  /// Null means the page keeps its plain Register button.
  formId String?
  form   Form?  @relation("ProgramForm", fields: [formId], references: [id], onDelete: SetNull)

  /// Who runs this program. A lead sees this one program's settings and its
  /// form answers without needing the run of the whole console.
  leads User[] @relation("ProgramLeads")

  sort Int @default(0)

  /// Whether each school may be approached about this program, and why.
  lights      SchoolProgramLight[]
  agendaItems AdminMeetingItem[]
  enrollments ProgramEnrollment[]
  ambassadors ProgramAmbassador[]
  ambassadorInvites AmbassadorInvite[]

  /// A promo video for the top of the program page. YouTube, Vimeo or a
  /// direct file — whatever the team has.
  videoUrl String?
  steps ProgramStep[]
  events ProgramEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProgramStep {
  id          Int    @id @default(autoincrement())
  programId   Int
  /// "01", "02" — shown as written.
  step        String
  title       String
  description String @db.Text
  /// Optional call to action on the stage — "Book a time", "Register and pay".
  linkLabel   String?
  /// Where it goes. "{form}" resolves to this program's own sign-up form.
  linkUrl     String?
  order       Int    @default(0)

  program ProgramPage @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId])
}

// ─── Contact form ─────────────────────────────────────────────────────────────
// The contact route used to validate a message and throw it away. Stored here
// so nothing a school writes is lost, whether or not mail is switched on.

model ContactMessage {
  id         String  @id @default(cuid())
  name       String
  email      String
  schoolName String?
  role       String?
  subject    String?
  message    String  @db.Text

  /// Set once someone at JOC has dealt with it.
  handled Boolean @default(false)
  /// Whether the notification email actually went out.
  emailed Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([handled, createdAt])
}

// ─── Orders ───────────────────────────────────────────────────────────────────
// A school's order, stored whether or not it is ever paid for online. Card
// payment is not connected; a purchase order is how schools buy from JOC
// today, and an order that only exists in somebody's outbox is an order JOC
// cannot see, chase, or fulfil.

enum OrderStatus {
  /// Placed on the site, nobody has looked at it yet.
  NEW
  /// JOC has confirmed the total and shipping.
  QUOTED
  /// Invoice sent, or payment received.
  INVOICED
  /// Sent or, for a download, released.
  FULFILLED
  CANCELLED
}

model Order {
  id     String      @id @default(cuid())
  status OrderStatus @default(NEW)

  /// Who placed it. Kept as text as well as a relation, so an order survives
  /// the account being removed.
  contactName  String
  contactEmail String
  phone        String?
  schoolName   String
  /// Blank for an order that is all downloads.
  address      String?
  /// The school's own purchase order number, when they have one.
  poNumber     String?
  notes        String? @db.Text

  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  /// Cents, at the moment the order was placed.
  subtotal Int
  /// What JOC wrote back — shipping, a discount, the final figure.
  response String? @db.Text

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  /// Copied, so the line still reads correctly if the product is renamed,
  /// repriced or deleted.
  name      String
  unit      String
  unitPrice Int
  quantity  Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ─── Staff room ───────────────────────────────────────────────────────────────
// Topic rooms where educators talk to each other. The Teachers' Board is for
// finished write-ups of something a school ran; this is the conversation —
// a question on a Tuesday, four answers by Thursday.
//
// Rooms are open to anyone signed in with live access. Nothing is approved in
// advance: a moderated conversation is not a conversation. The education team
// can remove a message, and any author can remove their own.

model Room {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String
  /// An emoji, shown beside the name.
  icon        String  @default("💬")
  sort        Int     @default(0)
  /// Closed to new messages, kept readable.
  archived    Boolean @default(false)

  /// Set to tie a room to one Chesed Cycle's weeks.
  cycleSlug String?

  messages RoomMessage[]
  members  RoomMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([archived, sort])
}

/// Who is following a room, and how much of it they have read.
model RoomMember {
  userId String
  roomId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  lastReadAt DateTime @default(now())
  joinedAt   DateTime @default(now())

  @@id([userId, roomId])
  @@index([roomId])
}

model RoomMessage {
  id     String @id @default(cuid())
  roomId String
  userId String

  body String @db.Text

  /// Set on a reply. One level only — a thread, not a tree.
  parentId String?
  parent   RoomMessage?  @relation("Thread", fields: [parentId], references: [id], onDelete: Cascade)
  replies  RoomMessage[] @relation("Thread")

  /// Kept rather than deleted, so a thread does not lose its shape.
  removed   Boolean @default(false)
  removedBy String?

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roomId, createdAt])
  @@index([parentId])
}

// ─── Chesed Cycles ────────────────────────────────────────────────────────────
// The eight themes a school year is built around. These lived in lib/cycles.ts
// as a hardcoded array, which meant the spine of the whole product — including
// dates nobody had checked against a luach — could only be changed by a
// developer. The static list stays as the fallback until a cycle is saved here.

model Cycle {
  id   Int    @id @default(autoincrement())
  slug String @unique
  /// 1–8, and the order they run in.
  num  Int    @unique

  theme    String
  /// The plain-English line under the theme.
  gloss    String
  /// What the cycle asks a student. Shown large on the cycle page.
  question String

  /// Hebrew month label, e.g. "Elul – Tishrei".
  hebrew String
  /// What it is pinned to, e.g. "School opening → Yom Kippur".
  anchor String
  /// Human-readable secular range, e.g. "Aug 30 – Sep 26".
  range  String

  startDate DateTime
  endDate   DateTime
  weeks     Int

  color String @default("#2D46AF")

  /// Labels shown on the cycle. This replaced a single `israel` boolean —
  /// one hardcoded checkbox meant the education team had to ask a developer
  /// for any label but that one. Free text on purpose: JOC decides its own
  /// vocabulary, and can pick as many as apply.
  tags String[] @default([])

  /// Kept only so the old data is recoverable; nothing reads it. The values
  /// were copied into `tags` by the 20260915190000_cycle_tags migration.
  israel Boolean @default(false)

  desc  String   @db.Text
  focus String[]

  weekPlan CycleWeek[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startDate])
}

model CycleWeek {
  id      Int    @id @default(autoincrement())
  cycleId Int
  title   String
  body    String @db.Text
  order   Int    @default(0)

  cycle Cycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@index([cycleId])
}

// ─── Pricing ──────────────────────────────────────────────────────────────────
// Every price on /pricing was written into the component, so changing one
// meant a deploy — on the page a menahel reads before deciding. These are the
// two tables that page renders.

model PricingPlan {
  id    Int    @id @default(autoincrement())
  /// "teacher", "staff", "app" — matches the column keys on the page.
  key   String @unique
  label String

  /// Monthly, in whole dollars, by school size.
  priceSmall  Int
  priceMedium Int
  priceLarge  Int

  sort Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// What each program costs at each subscription tier.
model ProgramPrice {
  id    Int    @id @default(autoincrement())
  label String
  sort  Int    @default(0)

  /// Keyed by tier — none, teacher, staff, app, full. Each value is one of
  /// { cents: n }, { included: true } or { na: true }, which is exactly the
  /// shape the pricing table renders.
  tiers Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One thing happening, on a date, at a school.
///
/// The Chesed Cycles say what the whole network is learning this month;
/// this says what is actually being *run* and when — a Kindness Booth at
/// one school on the 14th, a Bake for Chesed across every school in Adar.
/// It is the programming team's calendar, and the public Programming page
/// is a read-only view of whatever is published here.
model ProgramEvent {
  id    Int    @id @default(autoincrement())
  slug  String @unique
  title String

  /// The two things on the calendar are genuinely different, and the
  /// difference is not "is a school named". A Run for Chesed happens at one
  /// park and is still a JOC event; a Kindness Booth at one school is a
  /// school program even though JOC supplies it. Stated outright rather than
  /// inferred, because the page shows them as two separate lists.
  kind EventKind @default(SCHOOL_PROGRAM)

  /// Which JOC program this is a running of, where it is one of ours.
  /// Null for a one-off that is not in the catalogue.
  programId Int?
  program   ProgramPage? @relation(fields: [programId], references: [id], onDelete: SetNull)

  /// The school it runs at. Null means open to every school.
  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  /// Stored as a plain day when allDay, so it never shifts across timezones.
  startsAt DateTime
  /// Null for a single-day event.
  endsAt   DateTime?
  allDay   Boolean   @default(true)

  location String?
  /// "Grades 3–5", "Whole school", "Staff only".
  audience String?
  detail   String  @db.Text @default("")
  /// Who at JOC is running it.
  lead     String?

  status    EventStatus @default(PLANNED)
  /// Unpublished events are the programming team's working calendar and are
  /// never visible outside the console.
  published Boolean     @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reports EventReport[]

  @@index([startsAt])
  @@index([schoolId])
  @@index([published, startsAt])
  @@index([kind, startsAt])
}

enum EventKind {
  /// A big JOC event — the whole network, or anyone who wants to come.
  JOC_EVENT
  /// One program running at one school. There will be many of these.
  SCHOOL_PROGRAM
}

enum EventStatus {
  /// Pencilled in.
  PLANNED
  /// Agreed with the school.
  CONFIRMED
  /// Happened.
  DONE
  /// Called off. Kept, so the history is honest.
  CANCELLED
}

/// A named bundle of things somebody is allowed to do in the console.
///
/// The four that ship — JOC staff, Programming team, Educational team, Super
/// admin — were hardcoded in src/lib/access.ts, which meant a new kind of
/// admin needed a developer. They are rows now, and JOC can add its own:
/// a shop manager, an Israel trips coordinator, whatever the work turns out
/// to need.
///
/// `capabilities` holds the keys listed in CAPABILITIES in src/lib/access.ts.
/// Anything unrecognised is ignored rather than trusted, so a stale row can
/// never grant something that no longer exists.
model AdminRole {
  id          String  @id @default(cuid())
  name        String  @unique
  /// One line, shown beside the name so it is obvious who this is for.
  description String?

  capabilities String[] @default([])

  /// The four that ship. They can be renamed and their capabilities changed,
  /// but they cannot be deleted — the console would have nobody to run it.
  builtIn Boolean @default(false)

  /// True for the super admin row only. Always holds every capability, and
  /// the console refuses to take any away: without this it is possible to
  /// remove your own access and lock everybody out permanently.
  isSuperAdmin Boolean @default(false)

  sort Int @default(0)

  members User[] @relation("AdminRoleMembers")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sort])
}

/// A form the JOC team builds in the console: trip registration, a feedback
/// round, a sign-up sheet. Fields are rows rather than code, so a new form
/// never needs a developer.
model Form {
  id    String @id @default(cuid())
  slug  String @unique
  title String

  /// Shown above the fields.
  description String @db.Text @default("")
  /// Shown after somebody submits. Where to say "we will be in touch".
  thankYou    String @db.Text @default("Thank you — we have your answers.")

  published Boolean @default(false)
  /// A form that has closed says so, rather than vanishing. Somebody sent a
  /// link to a school last week and needs to be told it has shut, not shown
  /// a page that is not found.
  closed    Boolean @default(false)
  /// Only signed-in people may submit. Off for anything a parent fills in.
  requiresSignIn Boolean @default(false)

  /// What it costs to submit, in cents. Null means free. Nothing is charged
  /// until Stripe is connected — see src/lib/payments.ts.
  feeCents    Int?
  feeLabel    String?

  fields    FormField[]
  responses FormResponse[]
  programs  ProgramPage[] @relation("ProgramForm")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
}

model FormField {
  id     String @id @default(cuid())
  formId String

  label String
  /// The small grey line under the label.
  help  String?
  type  FormFieldType @default(SHORT_TEXT)

  required Boolean  @default(false)
  /// For CHOICE and CHECKBOXES.
  options  String[] @default([])
  order    Int      @default(0)

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId, order])
}

enum FormFieldType {
  SHORT_TEXT
  LONG_TEXT
  EMAIL
  PHONE
  NUMBER
  DATE
  /// One of a list.
  CHOICE
  /// Any number of a list.
  CHECKBOXES
  YES_NO
}

/// One submission.
model FormResponse {
  id     String @id @default(cuid())
  formId String

  /// Which school this sign-up is for. Taken from the signed-in person's
  /// school where there is one. Without it a school can never be shown its
  /// own registrations, and every response collected before this existed is
  /// one nobody can attribute.
  schoolId String?

  /// Set when the person was signed in.
  userId String?
  user   User?   @relation("FormResponses", fields: [userId], references: [id], onDelete: SetNull)

  /// Always asked for, so JOC can reply to somebody who was not signed in.
  name  String?
  email String?

  /// [{ fieldId, label, value }] — the label is snapshotted at submit time on
  /// purpose. Renaming or deleting a field later must not turn an answer
  /// somebody already gave into an orphan nobody can read.
  answers Json

  /// Only meaningful on a form with a fee.
  paid          Boolean @default(false)
  paymentRef    String?
  amountCents   Int?

  createdAt DateTime @default(now())

  form   Form    @relation(fields: [formId], references: [id], onDelete: Cascade)
  school School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([formId, createdAt])
  @@index([schoolId])
  @@index([userId])
}


// ─── JOC App activity ─────────────────────────────────────────────────────────
//
// Everything below is written by the sync and read by the console. Nothing in
// here is edited by a person, and nothing in here is the source of truth — the
// app is. Each row carries the moment it was read, because a figure with no
// age goes on looking true long after it is not.

model AppSchoolStats {
  schoolId String @id
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  /// Chesed hours, in minutes so nothing is lost to rounding on the way in.
  minutesThisWeek  Int @default(0)
  minutesThisCycle Int @default(0)
  minutesThisYear  Int @default(0)

  /// Waiting for a teacher to approve.
  unapprovedMinutes  Int       @default(0)
  unapprovedEntries  Int       @default(0)
  unapprovedStudents Int       @default(0)
  /// The oldest thing still waiting. This is what the 7-day flag measures.
  unapprovedOldestAt DateTime?
  /// Age buckets, so the panel does not have to hold every entry to say
  /// how bad it is.
  unapprovedThisWeek Int @default(0)
  unapprovedOneToTwo Int @default(0)
  unapprovedOverTwo  Int @default(0)

  /// A student who logged anything in the last 30 days.
  activeStudents      Int @default(0)
  activeStudentsLast  Int @default(0)

  opportunitiesOpen      Int @default(0)
  opportunitiesThisWeek  Int @default(0)
  opportunitiesThisCycle Int @default(0)

  /// The most recent thing anybody there did, described without a name.
  lastActivityAt   DateTime?
  lastActivityText String?

  /// Null means the app cannot answer this yet, which the panel says in
  /// words. Zero means it answered and the answer was none.
  storeRedeemedThisMonth Int?
  storeTopPrize          String?
  storeLastRedeemedAt    DateTime?

  /// When the sync last read all of this out of the app.
  syncedAt DateTime

  @@index([syncedAt])
}

model AppChallengeStat {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  appChallengeId String
  title          String
  /// The Chesed Cycle it belongs to, where the app says so.
  cycleSlug      String?
  joined         Int    @default(0)
  finished       Int    @default(0)
  running        Boolean @default(true)

  syncedAt DateTime

  @@unique([schoolId, appChallengeId])
  @@index([schoolId])
}

model AppSchoolMessage {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  appMessageId String @unique
  /// Who at the school wrote it. A name is allowed here because somebody has
  /// to be rung back; the panel shows no student names anywhere else.
  fromName  String?
  body      String   @db.Text
  sentAt    DateTime
  /// Answered inside the app. Unanswered is what raises the flag.
  answered  Boolean  @default(false)

  syncedAt DateTime

  @@index([schoolId, answered])
}

/// One run of the sync. The console reads the newest successful one to work
/// out how old everything on the page is.
model AppSyncRun {
  id         String        @id @default(cuid())
  startedAt  DateTime      @default(now())
  finishedAt DateTime?
  status     AppSyncStatus @default(RUNNING)
  /// How many school rows were written.
  rows       Int           @default(0)
  /// App records whose school we could not match. Counted here and nowhere
  /// else: an unattributed record is shown to nobody.
  unmatched  Int           @default(0)
  error      String?       @db.Text

  @@index([startedAt])
  @@index([status, finishedAt])
}

enum AppSyncStatus {
  RUNNING
  OK
  FAILED
}

// ─── The traffic light ───────────────────────────────────────────────────────

/// Whether a coordinator may approach this school about this program.
///
/// One row per school per program, and there is a row for every pair — a
/// school with no row would be a school nobody knows what to do about, which
/// is the thing this table exists to abolish.
///
/// Most rows are written by the nightly rules. A row somebody set by hand
/// beats the rules and stays until it is changed or until `until` passes.
model SchoolProgramLight {
  id        String  @id @default(cuid())
  schoolId  String
  programId Int

  light ProgramLight

  /// Why, in the words the console shows. Always present: a light with no
  /// reason is a coordinator guessing.
  reason String @db.Text

  source LightSource @default(RULE)

  /// Who set it, for a manual light. Null for the rules.
  setById String?
  setBy   User?   @relation("LightSetBy", fields: [setById], references: [id], onDelete: SetNull)
  setAt   DateTime @default(now())

  /// A manual light may be temporary — "hold off until after Pesach". When
  /// this passes the rules take the row back.
  until DateTime?

  /// Set when the person who put the manual light on has been told it
  /// expired. Null means they still need telling.
  expiryToldAt DateTime?

  school  School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  program ProgramPage @relation(fields: [programId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, programId])
  @@index([programId, light])
  @@index([source, until])
}

enum ProgramLight {
  /// Reach out.
  GREEN
  /// Discuss first.
  AMBER
  /// Hold off.
  RED
}

enum LightSource {
  /// Written by the nightly rules.
  RULE
  /// Set by a person, and therefore untouchable by the rules.
  MANUAL
}

/// The admin meeting an amber or red school gets taken to.
///
/// A date and nothing else, most of the time. It exists as a row rather than
/// a setting so that a coordinator can be told which meeting their school is
/// on — "the next one" is not an answer anybody can plan around.
model AdminMeeting {
  id      String   @id @default(cuid())
  meetsAt DateTime
  note    String?  @db.Text

  /// Set when the meeting has been worked through. A closed meeting stops
  /// collecting items; the next one starts.
  closedAt DateTime?

  items AdminMeetingItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([meetsAt])
}

/// One school, on one meeting's agenda, about one program.
model AdminMeetingItem {
  id        String @id @default(cuid())
  meetingId String
  schoolId  String
  programId Int

  /// The light at the moment it was raised, so the agenda still reads
  /// correctly after somebody changes it.
  light ProgramLight
  kind  AgendaKind

  note String @db.Text

  createdById String?
  createdBy   User?   @relation("AgendaRaisedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  /// What the admins decided. Null until the meeting works through it.
  outcome     AgendaOutcome?
  outcomeNote String?        @db.Text
  outcomeAt   DateTime?
  outcomeById String?
  outcomeBy   User?          @relation("AgendaDecidedBy", fields: [outcomeById], references: [id], onDelete: SetNull)

  meeting AdminMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  school  School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  program ProgramPage  @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@index([programId])
  @@index([schoolId])
}

enum AgendaKind {
  /// "Let's review" — an amber school the coordinator wants a steer on.
  REVIEW
  /// A red school sent back for the admins to look at again.
  SEND_FOR_REVIEW
  /// A red school the coordinator thinks should be reconsidered.
  SUGGEST_APPEAL
}

enum AgendaOutcome {
  /// The light stands.
  KEEP_LIGHT
  /// The light was changed. The reason is in outcomeNote.
  CHANGE_LIGHT
  /// Closed with nothing changed.
  CLOSED
}

// ─── Which school runs which program ─────────────────────────────────────────

/// One school running one program, and how far along it is.
///
/// This was inferred rather than stored: "in the program" meant either a
/// non-cancelled ProgramEvent or a form response against the program's form,
/// worked out separately in src/lib/program-traffic.ts and
/// src/lib/program-lights.ts. Two copies of a rule with no table behind it,
/// and no way at all to say a school is registered but not trained yet —
/// which is the question a growing nonprofit asks most.
model ProgramEnrollment {
  id        String @id @default(cuid())
  schoolId  String
  programId Int

  stage EnrollmentStage @default(INTRODUCED)
  /// When it reached this stage. A stage with no date cannot answer "how long
  /// has this school been sitting at registered", which is the useful question.
  stageSince DateTime @default(now())

  /// The person at the school who runs this program. Their own contact row,
  /// so the account team and the coordinator are ringing the same person.
  contactId String?
  contact   SchoolContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  /// When it first actually ran there, and when it stopped.
  startedAt DateTime?
  endedAt   DateTime?

  note String? @db.Text

  school  School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  program ProgramPage @relation(fields: [programId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, programId])
  @@index([programId, stage])
  @@index([schoolId])
}

/// How far a school has got with one program.
///
/// Deliberately not the same list as SchoolStatus. That one is about the
/// account — whether they pay. This is about one program, and a school can be
/// a paying customer that has never run the Kindness Booth.
enum EnrollmentStage {
  /// Somebody reached out. The traffic light's "Reach out" lands here.
  INTRODUCED
  MEETING_BOOKED
  /// Their form is in.
  REGISTERED
  MATERIALS_SENT
  TRAINED
  /// It has run there once.
  LAUNCHED
  /// It runs there as a matter of course.
  RUNNING
  /// On hold, expected back.
  PAUSED
  /// They stopped. Kept, so the history is honest.
  ENDED
}

// ─── Student ambassadors ─────────────────────────────────────────────────────

/// One student running one program at one school, for a bounded period.
///
/// Every other role here is scoped to at most a school. An ambassador has to
/// be scoped to *a program at a school*, which is why this is a table rather
/// than another value in the Role enum: a student with only a role would see
/// every program their school runs, which is the one thing this must prevent.
///
/// Two per program per school. The cap is enforced when a code is redeemed,
/// not here, because a tenure that has ended does not use up a place.
model ProgramAmbassador {
  id        String @id @default(cuid())
  userId    String
  schoolId  String
  programId Int

  /// The teacher who invited them and who reads their reports. Restrict
  /// rather than SetNull: an ambassador with nobody supervising them is a
  /// student writing into a void, so the teacher has to be handed over first.
  supervisorId String

  startsAt DateTime  @default(now())
  /// Tenure end. Past this the scope is gone — checked in the scope helper,
  /// not hidden in the interface.
  endsAt   DateTime?

  user       User        @relation("AmbassadorUser", fields: [userId], references: [id], onDelete: Cascade)
  supervisor User        @relation("AmbassadorSupervisor", fields: [supervisorId], references: [id], onDelete: Restrict)
  school     School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  program    ProgramPage @relation(fields: [programId], references: [id], onDelete: Cascade)

  reports EventReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, schoolId, programId])
  @@index([schoolId, programId])
  @@index([supervisorId])
}

/// A code a teacher hands to a student, on paper or out loud.
///
/// Not an email. These are minors at a school JOC does not employ, and the
/// portal's send gate blocks mail to them anyway — so the invitation travels
/// the way everything else at a school travels, which is a teacher telling
/// somebody something.
///
/// Knowing a code grants nothing beyond one program at one school, and only
/// until it expires or its two places are taken.
model AmbassadorInvite {
  id        String @id @default(cuid())
  code      String @unique
  schoolId  String
  programId Int

  createdById String
  createdBy   User   @relation("AmbassadorInviter", fields: [createdById], references: [id], onDelete: Cascade)

  expiresAt DateTime
  /// Redemptions so far. Refused at two.
  usedCount Int       @default(0)
  revokedAt DateTime?

  school  School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  program ProgramPage @relation(fields: [programId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([schoolId, programId])
  @@index([expiresAt])
}

/// What happened when the program actually ran.
///
/// Written by the student who ran it, read in full by their teacher, and
/// counted — not quoted with their name on it — by JOC. See the privacy rules
/// in src/lib/ambassadors.ts.
model EventReport {
  id           String @id @default(cuid())
  ambassadorId String

  /// The calendar entry this reports on, where there is one. Null when the
  /// ambassador ran something the calendar never knew about, which is itself
  /// the most valuable thing this table records.
  eventId Int?

  occurredOn DateTime
  /// The student's own estimate, and labelled as one everywhere it is shown.
  /// A CRM figure that reads as measured and is not is worse than no figure.
  participants Int?

  whatHappened String  @db.Text
  wentWell     String? @db.Text
  wouldChange  String? @db.Text

  /// Optional, and a photo of a school event has other people's children in
  /// it. Visible to the supervising teacher; reaches JOC only when the
  /// teacher says it may.
  photoId       String?
  photoShared   Boolean @default(false)

  submittedAt        DateTime  @default(now())
  /// Set when the supervising teacher has read it.
  seenBySupervisorAt DateTime?

  ambassador ProgramAmbassador @relation(fields: [ambassadorId], references: [id], onDelete: Cascade)
  event      ProgramEvent?     @relation(fields: [eventId], references: [id], onDelete: SetNull)
  photo      StoredFile?       @relation("ReportPhoto", fields: [photoId], references: [id], onDelete: SetNull)

  @@index([ambassadorId, occurredOn])
  @@index([eventId])
  @@index([occurredOn])
}
