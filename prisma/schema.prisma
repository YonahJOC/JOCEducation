// JOC Education — Prisma schema
// Run: npx prisma migrate dev --name init
// Requires .env.local with DATABASE_URL (pooler port 6543) and DIRECT_URL (direct port 5432)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── NextAuth v5 / @auth/prisma-adapter ──────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(TEACHER)
  schoolName    String?
  schoolRegion  String?

  accounts     Account[]
  sessions     Session[]
  savedLessons SavedLesson[]
  boardPosts   BoardPost[]
  boardLikes   BoardLike[]
  subscription Subscription?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ─── Subscriptions ────────────────────────────────────────────────────────────

model Subscription {
  id             String             @id @default(cuid())
  userId         String             @unique
  plan           Plan
  status         SubscriptionStatus @default(ACTIVE)
  stripeCustomerId  String?         @unique
  stripeSubId       String?         @unique
  currentPeriodEnd  DateTime?
  seats             Int             @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Lesson Plans ─────────────────────────────────────────────────────────────

model LessonPlan {
  id          Int          @id @default(autoincrement())
  slug        String       @unique
  theme       String
  title       String
  description String       @db.Text
  grade       Grade
  timeMinutes Int
  prep        PrepLevel
  published   Boolean      @default(true)
  featured    Boolean      @default(false)

  files       LessonFile[]
  objectives  LessonObjective[]
  materials   LessonMaterial[]
  steps       LessonStep[]
  discussion  LessonDiscussion[]
  savedBy     SavedLesson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LessonFile {
  id       Int    @id @default(autoincrement())
  lessonId Int
  name     String
  url      String

  lesson LessonPlan @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

model LessonObjective {
  id       Int    @id @default(autoincrement())
  lessonId Int
  text     String
  order    Int    @default(0)

  lesson LessonPlan @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

model LessonMaterial {
  id       Int    @id @default(autoincrement())
  lessonId Int
  text     String
  order    Int    @default(0)

  lesson LessonPlan @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

model LessonStep {
  id          Int    @id @default(autoincrement())
  lessonId    Int
  duration    String
  title       String
  description String @db.Text
  order       Int    @default(0)

  lesson LessonPlan @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

model LessonDiscussion {
  id       Int    @id @default(autoincrement())
  lessonId Int
  text     String @db.Text
  order    Int    @default(0)

  lesson LessonPlan @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

model SavedLesson {
  userId   String
  lessonId Int

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson LessonPlan @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  savedAt DateTime @default(now())

  @@id([userId, lessonId])
}

// ─── Resources ────────────────────────────────────────────────────────────────

model Resource {
  id          Int          @id @default(autoincrement())
  tag         String
  title       String
  description String       @db.Text
  fileUrl     String?
  published   Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Teachers' Board ──────────────────────────────────────────────────────────

model BoardPost {
  id         String      @id @default(cuid())
  userId     String
  title      String
  body       String      @db.Text
  grade      Grade
  region     String
  schoolName String
  likes      Int         @default(0)
  approved   Boolean     @default(true)

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  likedBy BoardLike[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BoardLike {
  userId    String
  postId    String

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  post BoardPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, postId])
}

// ─── Shop ─────────────────────────────────────────────────────────────────────

model Product {
  id          String   @id @default(cuid())
  name        String
  description String   @db.Text
  price       Int
  unit        String   @default("item")
  inStock     Boolean  @default(true)
  stripePriceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  TEACHER
  ADMIN
  SCHOOL_ADMIN
}

enum Grade {
  es
  ms
  hs
}

enum PrepLevel {
  Minimal
  Moderate
  Substantial
}

enum Plan {
  SINGLE_TEACHER
  SCHOOL_WIDE
  MULTI_SCHOOL
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}
