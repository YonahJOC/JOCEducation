# JOC Education — environment variables
# Copy to .env.local for development. In production these live in
# Vercel → joc-education-app → Settings → Environment Variables.
# Never commit real values.

# ─── Database (Supabase) ─────────────────────────────────────────────────────
# Supabase → Connect. Pooler for the app, direct for migrations.
DATABASE_URL="postgresql://...@...pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://...@...supabase.com:5432/postgres"

# ─── Authentication ──────────────────────────────────────────────────────────
# Generate fresh: openssl rand -base64 32
AUTH_SECRET=""

# Google Cloud Console → OAuth 2.0 Client ID (Web application).
# Redirect URI: https://education.justonechesed.org/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional. Adds to the built-in founders list in src/lib/access.ts; it does not replace it.
SUPER_ADMIN_EMAILS=""


# ─── The login gate ──────────────────────────────────────────────────────────
# The landing page at / is the only public route; everything else needs an
# account. In production the gate is ON by default — it does not need turning
# on, and there is no GATE_ENABLED. This file used to say there was, which
# would have had somebody set a variable nothing reads and believe the gate
# was live when it already was.
#
# Set this ONLY to deliberately open the whole site to the public, which is
# what launch day looks like. Confirm Google sign-in works first.
# GATE_DISABLED="true"

# ─── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL="https://education.justonechesed.org"

# ─── Not yet used ────────────────────────────────────────────────────────────
# RESEND_API_KEY=""
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
